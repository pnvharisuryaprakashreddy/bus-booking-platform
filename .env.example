# Local placeholders only. Copy to .env and do not commit .env.
# These are not production secrets.

APP_ENV=local
APP_VERSION=local
LOG_LEVEL=INFO
IMAGE_TAG=local

POSTGRES_DB=busbooking
POSTGRES_PASSWORD=postgres
BUSAPP_PASSWORD=busapp_local_only

# Used by the API container. Host name "db" is the Compose service.
DATABASE_URL=postgresql://busapp:busapp_local_only@db:5432/busbooking

# Required on booking and cancellation requests (header X-API-Key).
API_KEY=dev-api-key
TZ_NAME=Asia/Kolkata
